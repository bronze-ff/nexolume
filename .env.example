# Nexolume ainda não tem aplicação. Nenhum processo, script ou workflow lê este arquivo.
# Os nomes abaixo são o contrato da Fatia 1 para quando o código existir.
# Valores secretos ficam vazios: o repositório é público.
#
# Não há Sentry nem PostHog. Não acrescente DSN nem chave de analytics.

# Formato, quando houver app: postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require
# Projeto Neon previsto: nexolume (shiny-feather-64709994), branch main, database neondb.
# A connection string real fica só no .env local.
DATABASE_URL=

# Repositório do vault, somente leitura. Não é segredo.
VAULT_REPO=bronze-ff/obsidian-second-brain
VAULT_PASTA=raw

# Token do GitHub com leitura do vault. Cole o valor só no .env local.
GITHUB_TOKEN=

# mock | claude-cli | anthropic-api
NEXOLUME_LLM_PROVIDER=mock

# Só quando NEXOLUME_LLM_PROVIDER=anthropic-api (Fatia 3).
ANTHROPIC_API_KEY=

# Intervalo do watcher, em milissegundos (5 minutos).
WATCHER_INTERVALO_MS=300000

PORT=3001
